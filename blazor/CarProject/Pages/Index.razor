@page "/"
<PageTitle>Car Change Corlor</PageTitle>

<h3 class="fw-bold">Change color car</h3>
<div class="d-flex ">
    <div class="me-3">
        <img src="@($"/image/car/car-{CarColor}.jpg")" style="width: 200px;" alt="@($"car-{CarColor}.jpg")">
    </div>
    <div class="d-flex align-self-start">
        <button type="button" class="btn btn-primary me-2" @onclick="@(e => ChangeColor("red"))">Red color</button>
        <button type="button" class="btn btn-secondary me-2" @onclick="@(e => ChangeColor("silver"))">Silver
            color</button>
        <button type="button" class="btn btn-dark" @onclick="@(e => ChangeColor("black"))">Black color</button>
    </div>
</div>

@code {
    private string CarColor { get; set; } = "black";

    private void ChangeColor(string value)
    {
        Console.WriteLine(value);
        CarColor = value;
    }
}