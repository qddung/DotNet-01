@page "/"
@using System.Text.Json

<PageTitle>Customer Contact Form</PageTitle>
@{
    var checkStr = "true";
    if(model.Agree) checkStr = "";
}
<div class="contact-form">
    <h1>Customer Contact Form</h1>
    <EditForm Model="@model" OnValidSubmit="Submit">
        <DataAnnotationsValidator />
        @* <ValidationSummary /> *@
        <div class="mb-3">
            <label for="fullName" class="form-label">Full Name *</label>
            <input type="text" class="form-control" id="fullName" @bind="@model.FullName"
                placeholder="Enter your full name">
            <ValidationMessage class="form-text" For="@(() => model.FullName)" />
        </div>
        <div class="mb-3">
            <label for="email" class="form-label">Email *</label>
            <input type="email" class="form-control" id="email" @bind="@model.Email" placeholder="Enter your email">
            <ValidationMessage class="form-text" For="@(() => model.Email)" />
        </div>
        <div class="mb-3">
            <label for="phoneNumber" class="form-label">Phone Number *</label>
            <input type="tel" class="form-control" id="phoneNumber" @bind="@model.PhoneNumber"
                placeholder="Enter your phone number">
            <ValidationMessage class="form-text" For="@(() => model.PhoneNumber)" />

        </div>
        <div class="mb-3">
            <label for="address" class="form-label">Address</label>
            <input type="text" class="form-control" id="address" @bind="@model.Address"
                placeholder="Enter your address">
            <ValidationMessage class="form-text" For="@(() => model.Address)" />
        </div>
        <div class="mb-3">
            <label for="message" class="form-label">Message *</label>
            <textarea class="form-control" id="message" rows="3" @bind="@model.Message"
                placeholder="Enter your message"></textarea>
            <ValidationMessage class="form-text" For="@(() => model.Message)" />
        </div>
        <div class="mb-3">
            <label for="selectService" class="form-label">Select Service *</label>
            <select @bind="@model.ServiceId" class="form-select" id="selectService">
                <option value="">Choose...</option>

                @foreach (var item in Services.ListServices)
                {
                    <option value="@item.Value">@item.Name</option>
                }
            </select>
            <ValidationMessage class="form-text" For="@(() => model.ServiceId)" />
        </div>
        <div class="mb-3 form-check">
            <input type="checkbox" value="@checkStr" @onchange="ChangeRequest" class="form-check-input"
                id="terms">
            <label class="form-check-label" for="terms">I agree to the terms and conditions *</label>
            <ValidationMessage class="form-text" For="@(() => model.Agree)" />
        </div>
        <button type="submit" class="btn btn-primary w-100">Submit</button>

    </EditForm>
</div>

@code {
    @* [Parameter] *@
    public CustomerContact model { get; set; } = new CustomerContact();

    private void Submit()
    {
        var result = model;
        string json = JsonSerializer.Serialize(result);

        Console.WriteLine(json);
    }

    private void ChangeRequest()
    {
        @* Submit(); *@
        Console.WriteLine(model.Agree);
        model.Agree = !model.Agree;
    }
}