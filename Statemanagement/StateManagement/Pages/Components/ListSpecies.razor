@namespace StateManagement.Components
@inject BurgerService bugService


<table class="table">
    <thead>
        <tr>
            <th colspan="2">Thức ăn</th>
            <th></th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var increment in bugService.GetListInCrement())
        {
            <tr>
                <td colspan="2">@increment.Name</td>
                <td>
                    <button class="btn btn-success btn-control"
                        @onclick="@(() => bugService.IncreateIncrement(increment.Id))">+</button>
                    <span>@bugService.GetQuantity(increment.Id)</span>
                    <button class="btn btn-danger btn-control"
                        @onclick="@(() => bugService.DecreaseIncrement(increment.Id))">-</button>
                </td>
                <td>@increment.Price</td>
                <td>@increment.Total</td>

            </tr>
        }



    </tbody>
</table>
<h5>Tổng cộng: <strong>190</strong></h5>

