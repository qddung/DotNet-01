@page "/"
@* @implements IDisposable *@
@inject BurgerService bugService

<PageTitle>Index</PageTitle>

<div class="container text-center">
    <h2 class="mb-4">Bài tập Burger</h2>
    <div class="row">
        <!-- Burger Display -->
        <div class="col-md-6 burger-container">
            <div class="breadTop burger-layer"></div>

            @foreach (var increment in bugService.GetListInCrement())
            {

                @for (int i = 0; i < increment.Quantity; i++)
                {
                    <div class="@increment.ClassName burger-layer"></div>
                }
            }
            @* <div class="salad burger-layer"></div>
            <div class="salad burger-layer"></div>
            <div class="cheese burger-layer"></div>
            <div class="beef burger-layer"></div>
            <div class="beef burger-layer"></div> *@
            <div class="breadBottom burger-layer"></div>
        </div>

        <!-- Ingredient Controls -->
        <div class="col-md-6 control-panel">
            <h4>Chọn thức ăn</h4>
            <ListSpecies />
        </div>
    </div>
</div>

@code {
    public void onChange()
    {
        InvokeAsync(StateHasChanged);
    }
    protected override void OnInitialized()
    {
        bugService.OnChange += onChange;
    }

    void Dispose()
    {
        bugService.OnChange -= onChange;
    }
}
