@page "/product-management/add"
@using Microsoft.AspNetCore.SignalR.Client
@using System.Threading.Tasks
@inject ProductService state
@inject NavigationManager Navigation

<EditForm Model="@product" OnValidSubmit="OnSubmit" class="product-form">
    <DataAnnotationsValidator />
    <h2 class="mb-4">Add Product</h2>
    <div class="mb-3">
        <label class="form-label">Name:</label>
        <RadzenTextBox @bind-Value="product.name" class="form-control" />
        <ValidationMessage For="@(() => product.name)" class="text-danger" />
    </div>
    <div class="mb-3">
        <label class="form-label">Alias:</label>
        <RadzenTextBox @bind-Value="product.alias" class="form-control" />
        <ValidationMessage For="@(() => product.alias)" class="text-danger" />
    </div>
    <div class="mb-3">
        <label class="form-label">Price:</label>
        <RadzenNumeric TValue="double" Step="0.1" @bind-Value="product.price" class="form-control" />
        <ValidationMessage For="@(() => product.price)" class="text-danger" />
    </div>
    <div class="mb-3">
        <label class="form-label">Description:</label>
        <RadzenTextArea @bind-Value="product.description" class="form-control" />
        <ValidationMessage For="@(() => product.description)" class="text-danger" />
    </div>
    <div class="mb-3">
        <label class="form-label">Short Description:</label>
        <RadzenTextBox @bind-Value="product.shortDescription" class="form-control" />
        <ValidationMessage For="@(() => product.shortDescription)" class="text-danger" />
    </div>
    <div class="mb-3">
        <label class="form-label">Quantity:</label>
        <RadzenNumeric TValue="int" Step="1" @bind-Value="product.quantity" class="form-control" />
        <ValidationMessage For="@(() => product.quantity)" class="text-danger" />
    </div>
    <div class="mb-3">
        <label class="form-label">Image Link:</label>
        <RadzenTextBox @bind-Value="product.imgLink" class="form-control" />
        <ValidationMessage For="@(() => product.imgLink)" class="text-danger" />
    </div>
    <div class="mb-3">
        <RadzenButton Text="Add Product" ButtonType="ButtonType.Submit" Class="btn btn-primary" />
        <RadzenButton Text="Cancel" Click="@OnCancel" Class="btn btn-secondary ms-2" />
    </div>
    <div class="mt-3">
        <RadzenLink Text="<< Go back" Path="/product-management" Class="btn btn-link" />
    </div>
</EditForm>

@code {

    private HubConnection? hubConnection;
    private ProductAddNew product = new ProductAddNew();

    private async Task OnSubmit()
    {
        await state.AddNewProduct(product);
        // await hubConnection.SendAsync("LoadCategory
        hubConnection.InvokeAsync("LoadCategory");
        Navigation.NavigateTo("/product-management");
    }

    private void OnCancel()
    {
        Navigation.NavigateTo("/product-management", false);
    }

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
        .WithUrl(Navigation.ToAbsoluteUri("/product-hub"))
        .Build();
        await hubConnection.StartAsync();
    }

    public async ValueTask DisposeAsync()
    {
        state.Dispose();
        if(hubConnection is not null){
            await hubConnection.StopAsync();
        }
    }
}
