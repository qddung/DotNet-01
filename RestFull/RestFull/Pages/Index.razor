@page "/"
@inject ProductService prodService

<PageTitle>Index</PageTitle>

<Products />

@code {
    protected override async Task OnInitializedAsync()
    {
        prdService.OnChange += StateHasChanged;
        await prodService.GetAllProductApi();
    }

    public void Dispose()
    {
        prdService.OnChange -= StateHasChanged;

    }
}