@page "/"

<PageTitle>Wallet</PageTitle>

<div class="container">
    <WalletInfo info=@info ModalName="@ModalId" viewCreateTransactionCallback="openModalCreateTransaction"/>

    <Transactions listTransaction=@listTransaction />
    <CreateTransactionModal createTransactionModel="@createTransactionModel" ModalId="@ModalId" createTransactionCallback="createTransaction"
        closeModal="ResetCreateTransactionModel" />
</div>

@code {
    public WalletInfoViewModel info { get; set; } = new WalletInfoViewModel();
    public string ModalId { get; set; } = "CreateTransaction";
    public TransactionInfo createTransactionModel { get; set; } = null as TransactionInfo;
    public void openModalCreateTransaction(TransactionType type)
    {
        createTransactionModel = new TransactionInfo()
            {
                TransactionType = type,
            };
            string jsonString = JsonSerializer.Serialize(createTransactionModel);

        Console.WriteLine(jsonString);
    }

    public void ResetCreateTransactionModel()
    {
        createTransactionModel = null as TransactionInfo;
    }

    public void createTransaction(TransactionInfo createInfo)
    {
        string jsonString = JsonSerializer.Serialize(createInfo);

        Console.WriteLine(jsonString);
        listTransaction.Add(createInfo);
    }

    public List<TransactionInfo> listTransaction { get; set; } = new List<TransactionInfo>();
}